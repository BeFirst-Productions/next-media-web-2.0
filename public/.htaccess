Options -MultiViews
RewriteEngine On

# 1. If the request is for a directory but a .html file exists with the same name,
# we want to serve that .html file. This prevents the 403 Forbidden error.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 2. If a trailing slash is added to a path that has a .html file, 
# redirect to the clean URL without the slash.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 3. Standard 404 handling
ErrorDocument 404 /404.html