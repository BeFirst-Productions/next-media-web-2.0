Options -MultiViews
RewriteEngine On

# 1. If someone types /projects/, REDIRECT them to /projects (no slash)
# This prevents the 403 error by moving the user away from the folder path
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 2. Map the clean URL /projects to the actual file /projects.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# 3. Standard 404 handling
ErrorDocument 404 /404.html